<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C8C8D2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_btn"
        android:scaleType="center"
        android:src="@drawable/ic_prev"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_btn"
        android:scaleType="center"
        android:src="@drawable/ic_play_fill"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_btn"
        android:scaleType="center"
        android:src="@drawable/ic_next"
        android:tint="#FFFFFFFF" />
</LinearLayout>
